.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
# real datasets (Sparkov / IEEE-CIS / Amazon FDB / ULB) - large and/or Kaggle-auth
# gated, dropped in manually per README, never committed
data/*.csv
# trained model artifact - reproducible via `python scripts/train.py`
artifacts/*.joblib
HANDOFF.md

# Terraform working state. The provider lock files (.terraform.lock.hcl) are
# committed on purpose so every machine installs the same provider build.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# MLflow tracking store (local SQLite + run artifacts); rebuilt by any train or
# compare run once mlflow is installed, never committed (absolute paths inside)
mlflow.db
mlruns/
mlartifacts/
